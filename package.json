{
  "name": "eufaco",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:landing": "turbo run dev --filter=@eufaco/landing",
    "dev:mobile": "turbo run dev --filter=@eufaco/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.2.4"
}
